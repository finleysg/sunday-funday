# Sunday Fun Day — required env vars.
# Copy to .env (local dev) and configure in CapRover dashboard (prod).

# --- Database ---
# Local dev: pointed at the docker-compose MySQL on host port 3309.
# Prod: DO managed MySQL connection string.
DATABASE_URL="mysql://user:password@host:port/database"

# --- App URLs ---
# Used by better-auth for magic-link redirect URLs and absolute URL generation.
# Local dev: set to your Portless tunnel URL so magic-link emails are clickable from a phone.
# Prod: set to the public app URL (https://sundayfunday.example.com).
BETTER_AUTH_URL="https://sunday-funday.portless.dev"
NEXT_PUBLIC_APP_URL="https://sunday-funday.portless.dev"

# --- better-auth secret ---
# Generate via: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# --- SMTP (magic-link delivery) ---
# Local dev: Mailpit on localhost (UI: http://localhost:8029).
# Prod: Resend SMTP credentials.
SMTP_HOST="localhost"
SMTP_PORT="1029"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@sundayfunday.example.com"

# --- Admin gating ---
# Comma-separated email addresses. Users matching these are admins.
ADMIN_EMAILS=""

# --- PWA ---
# Set to "true" to register the service worker in dev.
NEXT_PUBLIC_ENABLE_SW="false"
