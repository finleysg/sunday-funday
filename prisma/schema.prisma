// Prisma schema. See decisions.md for domain-model rationale.
//
// Auth tables (User/Session/Account/Verification) are managed by better-auth.
// Field names mirror the better-auth-generated schema; do not rename without
// matching the better-auth config. Player joins to User by email on sign-in
// (logical link — no FK), per the invite-only-roster decision.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Player {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  active        Boolean  @default(true)
  // WHS Handicap Index. Course handicap is derived per (course, tee) at
  // roster time via `computeCourseHandicap` and snapshotted onto GameEntry.
  handicapIndex Decimal? @db.Decimal(3, 1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entries GameEntry[]

  @@map("player")
}

model Course {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holes CourseHole[]
  tees  Tee[]
  games Game[]

  @@map("course")
}

model CourseHole {
  courseId   String
  holeNumber Int
  par        Int
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([courseId, holeNumber])
  @@map("course_hole")
}

model Tee {
  id        String   @id @default(cuid())
  courseId  String
  name      String
  rating    Decimal  @db.Decimal(4, 1)
  slope     Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  holes   TeeHole[]
  entries GameEntry[]

  @@unique([courseId, name])
  @@index([courseId])
  @@map("tee")
}

model TeeHole {
  teeId       String
  holeNumber  Int
  strokeIndex Int
  tee         Tee    @relation(fields: [teeId], references: [id], onDelete: Cascade)

  @@id([teeId, holeNumber])
  @@map("tee_hole")
}

enum GameFormat {
  STROKE
  STABLEFORD
  CHICAGO_39
}

enum SkinsType {
  NONE
  NET
  HALF_SHOT
}

enum GameStatus {
  SETUP
  IN_PROGRESS
  COMPLETE
}

model Game {
  id        String     @id @default(cuid())
  name      String
  date      DateTime
  courseId  String
  format    GameFormat
  skinsType SkinsType  @default(NONE)
  status    GameStatus @default(SETUP)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  course  Course      @relation(fields: [courseId], references: [id])
  entries GameEntry[]
  groups  Group[]

  @@index([courseId])
  @@index([status, date])
  @@map("game")
}

model GameEntry {
  id             String   @id @default(cuid())
  gameId         String
  playerId       String
  teeId          String
  courseHandicap Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  game   Game         @relation(fields: [gameId], references: [id], onDelete: Cascade)
  player Player       @relation(fields: [playerId], references: [id])
  tee    Tee          @relation(fields: [teeId], references: [id])
  member GroupMember?
  scores Score[]

  @@unique([gameId, playerId])
  @@index([gameId])
  @@index([playerId])
  @@index([teeId])
  @@map("game_entry")
}

model Group {
  id        String   @id @default(cuid())
  gameId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game    Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  members GroupMember[]

  @@index([gameId])
  @@map("group")
}

model GroupMember {
  groupId     String
  gameEntryId String   @unique
  createdAt   DateTime @default(now())

  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  gameEntry GameEntry @relation(fields: [gameEntryId], references: [id], onDelete: Cascade)

  @@id([groupId, gameEntryId])
  @@index([groupId])
  @@map("group_member")
}

model Score {
  id              String    @id @default(cuid())
  gameEntryId     String
  holeNumber      Int
  strokes         Int?
  enteredByUserId String?
  enteredAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  gameEntry GameEntry @relation(fields: [gameEntryId], references: [id], onDelete: Cascade)

  @@unique([gameEntryId, holeNumber])
  @@index([gameEntryId])
  @@map("score")
}
